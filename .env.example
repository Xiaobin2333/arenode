PORT=3080
APP_ORIGIN=http://localhost:3080
# 多个 Arenode 站点共用同一 CDNFly 上游时必须各自唯一；请使用随机值，不要填写域名或 IP。
# 该值写入上游前会转换为不可逆的短站点标识。
UPSTREAM_GROUP_NAMESPACE=
DATABASE_URL=postgres://cdnfly:replace-with-database-password@localhost:5432/cdnfly_reseller
REDIS_URL=redis://localhost:6379
POSTGRES_PASSWORD=
# 首次部署默认关闭公开注册；确认邮件和人机验证配置完成后再在后台开启。
ALLOW_REGISTRATION=false
EMAIL_VERIFICATION_ENABLED=false
REQUIRE_LEGAL_CONSENT=true
AUTH_CODE_MINUTES=10
AUTH_CODE_COOLDOWN_SECONDS=60
AUTH_CODE_HOURLY_LIMIT=5
SETTINGS_ENCRYPTION_KEY=

# SMTP 邮件服务；仅本地开发可开启验证码回显。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
MAIL_DEV_EXPOSE_CODE=false

# CDNFly GET 缓存秒数；监控数据使用更短的独立缓存。
CDNFLY_CACHE_TTL_SECONDS=30
CDNFLY_MONITOR_CACHE_TTL_SECONDS=8
CDNFLY_REQUESTS_PER_MINUTE=300

# 可选：首次启动兼容迁移。配置后会自动创建一个默认上游及套餐；后续在后台维护多上游。
# CDNFly v6 API 地址，例如 https://panel.example.com/api
CDNFLY_BASE_URL=
CDNFLY_API_KEY=
CDNFLY_API_SECRET=
CDNFLY_CNAME_SUFFIX=

# 首次迁移时绑定到默认上游的平台套餐 ID
CDNFLY_USER_PACKAGE_ID=0

# 首次启动时创建管理员；创建后可从环境中删除密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 可选：复用人工创建或旧部署的数据卷时填写，并将 EXTERNAL 设为 true。
POSTGRES_VOLUME_NAME=arenode-postgres-data
REDIS_VOLUME_NAME=arenode-redis-data
ARENODE_EXTERNAL_VOLUMES=false
